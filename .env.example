# Copy to .env and fill in. Never commit .env.
TICKETMASTER_CONSUMER_KEY=
TICKETMASTER_CONSUMER_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SETLISTFM_API_KEY=

# Optional overrides
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Drafts by Claude (console at platform.claude.com; set a monthly spend limit there). Empty = Ollama only.
# ~$0.0005 per draft on Haiku. Ollama is the fallback over the daily cap or when the API call fails.
ANTHROPIC_API_KEY=
# DRAFT_PROVIDER=ollama          # force the local model even with a key
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_DAILY_CAP=40            # Claude calls per ET day
DASHBOARD_PORT=8765

# Cloudflare Pages read-only snapshot (optional; see docs/agent-notes/environment.md)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PAGES_PROJECT=

# Optional: edit from your phone through a Cloudflare Tunnel + Access (tracker/remote.py).
# Fill with: .venv\Scripts\python -m tracker.remote --setup <hostname> "<Access policy name>"
REMOTE_HOST=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional extra lock on top of the Access policy (comma-separated)
REMOTE_EMAILS=

# Optional: path to a ttspotslideshow plays.db (read-only) to boost artists you listen to
LISTENING_DB=

# Optional: setlist.fm key for "first Philly show since <year>" (free, non-commercial)
SETLISTFM_API_KEY=

# Optional: web context on idea cards (tracker/context.py), ~$0.0016 per lookup, capped at 10/day
PERPLEXITY_API_KEY=

# Not used by the code (compared against Perplexity on 2026-10-22, see status.md); kept for later
GEMINI_API_KEY=

# Optional: Last.fm for the music pillar (niche tags, related artists; docs/agent-notes/music-roadmap.md M7).
# Free key; the shared secret is only for write/auth calls, which the tracker doesn't make.
LAST_FM_API_KEY=
LAST_FM_SHARED_SECRET=